{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vitest/globals",
      "firefox-webext-browser"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "probe/src/**/*.ts",
    "probe/tests/**/*.ts",
    "probe/diagnostic/**/*.ts"
  ]
}
